# Config de PRODUCCIÓN. Vite carga este archivo solo en `vite build`
# (el Dockerfile además pasa los mismos valores como ARG/ENV).
#
# IMPORTANTE: la base es RELATIVA (/api/v2), no una URL absoluta. El front pega
# same-origin a /api/v2/... y el nginx del contenedor (docker/nginx.conf.template)
# la proxya al gateway. Una URL absoluta http://... rompe con Mixed Content
# (página HTTPS pidiendo recurso HTTP) y además salta el proxy.
VITE_API_BASE_URL=/api/v2

VITE_USE_MOCK=false
