server {
    listen       ${NGINX_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Proxy al gateway de microservicios.
    # El front pega same-origin a /api/v2/... y evita CORS / Mixed Content.
    location /api/v2/ {
        proxy_pass         ${API_UPSTREAM}/api/v2/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Subida de archivos a R2 (videos de capacitaciones hasta 600 MB).
    # nginx limita el body a 1 MB por defecto → sin esto los videos dan 413.
    # Tope alineado con el multipart de cloudflare-service-layer (629145600 bytes).
    location /api/v2/cloudflare/ {
        client_max_body_size    650m;
        proxy_request_buffering off;
        proxy_pass              ${API_UPSTREAM}/api/v2/cloudflare/;
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_send_timeout      900s;
        proxy_read_timeout      900s;
    }

    # Assets con hash en el nombre: cache agresivo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta desconocida cae en index.html (React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html nunca se cachea para que los deploys se vean de inmediato
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    gzip             on;
    gzip_types       text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length  1024;
}
